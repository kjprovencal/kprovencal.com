# Copy to your environment or systemd unit. Do not commit real secrets.

# At least 32 random bytes (e.g. openssl rand -base64 32)
SESSION_SECRET=

# Output of: go run ./cmd/hashpassword 'your-password'
ADMIN_PASSWORD_BCRYPT=

# Optional: default ./data/badger
# BADGER_PATH=data/badger

# Optional: default :8080
# LISTEN_ADDR=:8080

# Optional: slog level — debug, info (default), warn, error.
# info logs every HTTP request, warnings, and errors to stderr + the log file (not errors-only).
# LOG_LEVEL=info

# Optional: log file for the Admin → Logs tab. Default: api.log in the same directory as BADGER_PATH.
# LOG_PATH=/var/www/kprovencal/data/api.log

# Optional: host status JSON written by personal-site-host-maint. Default when unset:
# /var/lib/personal-site/host-status.json
# HOST_STATUS_PATH=/var/lib/personal-site/host-status.json

# Browser origin allowed to call the API (required when the static site and API differ, e.g. api subdomain).
# Dev: Vite dev server. Prod: main site origin (https://www.example.com), not the api host.
# CORS_ORIGIN=http://127.0.0.1:5173

# Cloudflare Turnstile secret (server-side). If unset, wedding RSVP accepts submissions without Turnstile (dev only).
# TURNSTILE_SECRET_KEY=

# When the API sits behind a trusted reverse proxy, set so Turnstile siteverify uses the first X-Forwarded-For hop as remoteip.
# The album PIN limiter uses the last hop, which is the client nginx appended.
# TRUST_PROXY=1

# Set production so session cookies are Secure (HTTPS only)
# APP_ENV=production

# Optional: admin session length in hours (default 12, max 720)
# ADMIN_SESSION_HOURS=12

# DigitalOcean Spaces for photo albums. Leave all five unset to disable albums.
# The Space must be private. Add a CORS rule that allows GET, PUT, and HEAD
# from the site origin (http://127.0.0.1:5173 in dev, and the production origin).
# Do not enable the Spaces CDN; public CDN URLs would skip the album PIN.
# SPACES_KEY=
# SPACES_SECRET=
# SPACES_BUCKET=
# SPACES_REGION=nyc3
# SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com

# Per-IP API rate limits (rolling 1-minute window). Pair with nginx limit_req in production.
# RATE_LIMIT_GET_MAX=300
# RATE_LIMIT_POST_MAX=60
# RATE_LIMIT_DISABLED=1
