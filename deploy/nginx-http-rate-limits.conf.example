# Rate limits for the personal site — include inside http { } in /etc/nginx/nginx.conf
# (above your server { } blocks), then reload nginx.
#
#   include /etc/nginx/conf.d/personal-site-rate-limits.conf;
#
# Per-IP limits slow path scanners and aggressive crawlers. Burst allows normal
# page loads (HTML + JS/CSS/images in a short burst).

limit_req_zone $binary_remote_addr zone=personal_site_static:10m rate=15r/s;
limit_req_zone $binary_remote_addr zone=personal_site_api:10m rate=8r/s;
limit_conn_zone $binary_remote_addr zone=personal_site_conn:10m;
