[Unit]
Description=Personal site API (Go + Badger)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Change User/Group to match ownership of DEPLOY_PATH and data directory.
User=www-data
Group=www-data
WorkingDirectory=/var/www/kprovencal
# Written by the deploy job from GitHub secrets. Mode 600, root:root.
EnvironmentFile=-/etc/personal-site-api.env
# Host status for Admin → Ops defaults to /var/lib/personal-site/host-status.json.
# Set HOST_STATUS_PATH in the environment file to override it. Do not put secrets in that JSON.
ExecStart=/var/www/kprovencal/personal-site-api
Restart=on-failure
RestartSec=5

# Hardening (optional; relax if the binary needs more)
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
